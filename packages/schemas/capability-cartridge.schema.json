{
  "$ref": "#/definitions/capability-cartridge",
  "definitions": {
    "capability-cartridge": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "application": {
          "type": "string",
          "maxLength": 100
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 500
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,39}$"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "approval": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "click"
                  },
                  "targetId": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "point": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "button": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right"
                    ]
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "approval": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "type"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "approval": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "press"
                  },
                  "key": {
                    "type": "string",
                    "enum": [
                      "WIN",
                      "ENTER",
                      "ESC",
                      "TAB",
                      "BACKSPACE",
                      "DELETE",
                      "CTRL+A",
                      "CTRL+C",
                      "CTRL+V",
                      "CTRL+S",
                      "ALT+F4",
                      "LEFT",
                      "RIGHT",
                      "UP",
                      "DOWN"
                    ]
                  }
                },
                "required": [
                  "type",
                  "key"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "approval": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "scroll"
                  },
                  "delta": {
                    "type": "integer",
                    "minimum": -1200,
                    "maximum": 1200
                  }
                },
                "required": [
                  "type",
                  "delta"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "approval": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "drag"
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 2,
                    "maxItems": 128
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 5000
                  }
                },
                "required": [
                  "type",
                  "points"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "approval": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "locate"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "approval": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "waitFor"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "approval": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "assert"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 20
        },
        "approvalRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 20
        },
        "metadata": {
          "type": "object",
          "properties": {
            "createdAt": {
              "type": "number"
            },
            "observationSource": {
              "type": "string",
              "maxLength": 100
            },
            "author": {
              "type": "string",
              "maxLength": 100
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1000
              },
              "maxItems": 100
            }
          },
          "required": [
            "createdAt",
            "observationSource",
            "author"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "name",
        "description",
        "application",
        "inputs",
        "steps",
        "assertions",
        "approvalRequirements",
        "metadata"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
